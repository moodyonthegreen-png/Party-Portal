# Copy to .env.local for local development. In Vercel, add these under
# Project Settings -> Environment Variables.

# Supabase -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Never expose to the browser, never commit, never paste in chat.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Printify (Printify -> My Profile -> Connections). Server-only.
PRINTIFY_API_TOKEN=
# Optional: only if your Printify account has more than one shop
PRINTIFY_SHOP_ID=
# Optional: pin a print provider per product, e.g. {"fleece-blanket": 99, "bodysuit": 29}
PRINTIFY_PROVIDERS=
